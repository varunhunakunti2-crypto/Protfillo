# --- Chat assistant (Groq) ---
# Server-side only: used by api/chat.js on Vercel and by the Vite dev middleware.
# Get a free key at https://console.groq.com/keys
# Vercel: Project Settings > Environment Variables -> add GROQ_API_KEY
# Local:  copy this file to .env.local and fill in the value
GROQ_API_KEY=your-groq-api-key
# Optional model override (defaults to openai/gpt-oss-120b).
# Must be a model your Groq account can access: https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b

# --- Contact form (Web3Forms) ---
# Injected into the client bundle via `define` in vite.config.js. That is
# intentional: Web3Forms' free plan only accepts browser-side submissions
# (server-side calls require their Pro plan), and their access key is a public
# alias to an email address rather than a secret.
# Get a free key at https://web3forms.com (email verification required).
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
