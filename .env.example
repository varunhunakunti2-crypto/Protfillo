# Server-side environment for the contact form proxy (netlify/functions/contact.mjs).
# The key is NEVER bundled into the client. Set it in the Netlify dashboard under
# Site settings > Environment variables, or via the CLI:
#   netlify env:set WEB3FORMS_ACCESS_KEY <your-key>
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# --- Chat assistant (Groq) ---
# Server-side only: used by api/chat.js on Vercel and by the Vite dev middleware.
# Get a free key at https://console.groq.com/keys
# Vercel: Project Settings > Environment Variables -> add GROQ_API_KEY
# Local:  copy this file to .env.local and fill in the value
GROQ_API_KEY=your-groq-api-key
# Optional model override (defaults to openai/gpt-oss-120b).
# Must be a model your Groq account can access: https://api.groq.com/openai/v1/models
# GROQ_MODEL=openai/gpt-oss-120b