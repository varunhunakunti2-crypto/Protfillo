# Dots Pro packages install from the private Dots registry, not npmjs.
# The token value lives only in the DOTS_TOKEN environment variable —
# set it in your shell (setx / $env:DOTS_TOKEN) or CI secrets before `npm install`.
@dots-swarm:registry=https://dotsui.dev/api/registry/
//dotsui.dev/api/registry/:_authToken=${DOTS_TOKEN}
